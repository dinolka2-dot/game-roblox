      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Enemies</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local PathfindingService = game:GetService("PathfindingService")
local Debris = game:GetService("Debris")
local Shared = game:GetService("ReplicatedStorage").Eldoria
local Config = require(Shared.Config)
local World = require(script.Parent.World)
local Characters = require(Shared.Characters)
local Enemies = {}; Enemies.__index = Enemies
function Enemies.new(root, callbacks)
    local self = setmetatable({root = root, list = {}, callbacks = callbacks}, Enemies)
    for _, pos in {Vector3.new(90, 3, -15), Vector3.new(110, 3, 20), Vector3.new(140, 3, -20), Vector3.new(165, 3, 18), Vector3.new(195, 3, -20), Vector3.new(210, 4.6, 0)} do
        local kind = if pos.X > 200 then "warden" elseif pos.X == 140 or pos.X == 195 then "shade" else "sentinel"
        local e = {kind = kind, home = pos, deadUntil = 0}
        table.insert(self.list, e); self:spawn(e)
    end
    return self
end
function Enemies:spawn(e)
    local c = Config.Enemies[e.kind]; e.hp = c.Health; e.hits = {}; e.attack = 0; e.slow = 0; e.nextPath = 0
    e.pending = nil; e.waypoints = nil; e.pathBusy = false; e.generation = (e.generation or 0) + 1
    e.model, e.body = Characters.create(self.root, c.Name, e.home, e.kind)
    e.label = World.label(e.body, c.Name)
end
function Enemies:hit(e, player, damage, slow)
    if self.callbacks.canEngage and not self.callbacks.canEngage(player, e) then return end
    if e.hp <= 0 then return end
    e.hp = math.max(0, e.hp - damage); e.hits[player] = os.clock()
    if slow then e.slow = os.clock() + 3 end
    if e.hp == 0 then
        if self.callbacks.death then self.callbacks.death(e.body.Position) end
        e.model:Destroy(); e.deadUntil = os.clock() + Config.Enemies[e.kind].Respawn
        for contributor, time in e.hits do
            local root = contributor.Character and contributor.Character:FindFirstChild("HumanoidRootPart")
            if contributor.Parent and root and (root.Position - e.home).Magnitude < 100 and os.clock() - time < 20 then
                self.callbacks.reward(contributor, Config.Enemies[e.kind], e.kind)
            end
        end
        e.hits = {}
    end
end
function Enemies:target(player, range, aim)
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local best, distance = nil, range
    local params = RaycastParams.new(); params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {player.Character}
    for _, e in self.list do
        if e.hp > 0 then
            local delta = e.body.Position - root.Position
            local d = delta.Magnitude
            if d <= distance and d > 0.01 and delta.Unit:Dot(aim) > 0.25 then
                local result = workspace:Raycast(root.Position, delta, params)
                if result == nil or result.Instance:IsDescendantOf(e.model) then best = e; distance = d end
            end
        end
    end
    return best
end
function Enemies:telegraph(e, radius, center)
    center = center or e.body.Position
    e.body:SetAttribute("AttackStart", workspace:GetServerTimeNow())
    local p = World.part(self.root, "Опасная область", Vector3.new(0.12, radius * 2, radius * 2), Vector3.new(center.X, 0.25, center.Z), Color3.fromRGB(255, 78, 80), Enum.Material.Neon)
    p.Shape = Enum.PartType.Cylinder; p.CFrame *= CFrame.Angles(0, 0, math.pi / 2)
    p.Transparency = 0.5; p.CanCollide = false; p.CanQuery = false
    Debris:AddItem(p, 0.9)
end
function Enemies:step(dt)
    local now = os.clock()
    for _, e in self.list do
        if e.hp <= 0 then
            if now >= e.deadUntil then self:spawn(e) end
            continue
        end
        local config = Config.Enemies[e.kind]
        e.label.Text = config.Name .. "\n" .. math.ceil(e.hp) .. " / " .. config.Health
        local target, distance = nil, config.Aggro
        for _, player in Players:GetPlayers() do
            local root, hum = self.callbacks.character(player)
            if root and hum.Health > 0 and (not self.callbacks.canEngage or self.callbacks.canEngage(player, e)) and Vector3.new(root.Position.X, 0, root.Position.Z).Magnitude > Config.SafeRadius then
                local d = (root.Position - e.body.Position).Magnitude
                if d < distance and (root.Position - e.home).Magnitude < 70 then target = player; distance = d end
            end
        end
        local targetRoot = target and self.callbacks.character(target)
        local destination = if targetRoot then targetRoot.Position else e.home
        -- Boss AoE is telegraphed, then rechecks current positions when it lands.
        if e.pending and now >= e.pending.time then
            local pending = e.pending; e.pending = nil
            for _, player in Players:GetPlayers() do
                local root = self.callbacks.character(player)
                if root and (not self.callbacks.canEngage or self.callbacks.canEngage(player, e)) and (root.Position - pending.center).Magnitude <= pending.radius then self.callbacks.damage(player, pending.damage) end
            end
        end
        if targetRoot and distance < (if e.kind == "warden" then 15 elseif e.kind == "shade" then 32 else 6) and now > e.attack and not e.pending then
            local phaseTwo = e.hp < config.Health * 0.5
            e.attack = now + (if phaseTwo then 1.7 else 2.5)
            local radius = if e.kind == "warden" then (if phaseTwo then 14 else 10) else 6
            local center = if e.kind == "shade" then targetRoot.Position else e.body.Position
            self:telegraph(e, radius, center)
            e.pending = {time = now + 0.8, center = center, radius = radius, damage = config.Damage}
        end
        if not e.pending and not (e.kind == "shade" and targetRoot and distance < 24) then
            local delta = Vector3.new(destination.X, e.body.Position.Y, destination.Z) - e.body.Position
            if delta.Magnitude > 4 then
                if now > e.nextPath and not e.pathBusy then
                    e.nextPath = now + 2; e.pathBusy = true
                    local generation = e.generation
                    task.spawn(function()
                        local path = PathfindingService:CreatePath({AgentRadius = 3, AgentHeight = 6, AgentCanJump = false})
                        local ok = pcall(function() path:ComputeAsync(e.body.Position, destination) end)
                        if e.hp > 0 and e.generation == generation then
                            e.waypoints = if ok and path.Status == Enum.PathStatus.Success then path:GetWaypoints() else nil
                            e.waypoint = 2; e.pathBusy = false
                        end
                        path:Destroy()
                    end)
                end
                local point = e.waypoints and e.waypoints[e.waypoint]
                if point then
                    delta = Vector3.new(point.Position.X, e.body.Position.Y, point.Position.Z) - e.body.Position
                    if delta.Magnitude < 3 then e.waypoint += 1 end
                end
                if delta.Magnitude > 0.01 then
                    local step = delta.Unit * math.min(delta.Magnitude, config.Speed * dt * (if now < e.slow then 0.45 else 1))
                    local params = RaycastParams.new(); params.FilterDescendantsInstances = {e.model}; params.FilterType = Enum.RaycastFilterType.Exclude
                    if not workspace:Raycast(e.body.Position, step * 2, params) then
                        local pos = e.body.Position + step
                        e.body.CFrame = CFrame.lookAt(pos, pos + delta.Unit)
                    end
                end
            end
        end
    end
end
return Enemies
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">FirstLocation</string>
          <string name="Source"><![CDATA[local Chapter = require(game:GetService("ReplicatedStorage").Eldoria.Chapter)
local Location = {}
function Location.build(root, World, callbacks)
    local folder = Instance.new("Folder"); folder.Name = "Долина первой зари"; folder.Parent = root
    local stone = Color3.fromRGB(96, 106, 115)
    local colors = {Color3.fromRGB(246, 139, 64), Color3.fromRGB(103, 220, 246), Color3.fromRGB(192, 140, 255)}
    local function block(name, size, cf, color, material, solid)
        local p = World.part(folder, name, size, cf.Position, color, material)
        p.CFrame = cf
        if solid == false then p.CanCollide = false; p.CanQuery = false; p.CanTouch = false end
        return p
    end
    for index, seal in Chapter.Seals do
        local origin = CFrame.new(seal.X, 0, seal.Z)
        local color = colors[index]
        local platform = block(seal.Name, Vector3.new(17, 0.6, 17), origin * CFrame.new(0, 0.3, 0), stone, Enum.Material.Cobblestone)
        World.label(platform, seal.Name .. "\nПечать " .. ({"огня", "льда", "бури"})[index], Vector3.new(0, 10, 0))
        for side = -1, 1, 2 do
            block("Колонна печати", Vector3.new(2, 7, 2), origin * CFrame.new(side*6, 4, 5), stone, Enum.Material.Marble)
            local crystal = block("Кристалл", Vector3.new(1.4, 2.2, 1.4), origin * CFrame.new(side*6, 8, 5) * CFrame.Angles(0, 0, math.pi/4), color, Enum.Material.Neon, false)
            local light = Instance.new("PointLight"); light.Color = color; light.Brightness = 0.7; light.Range = 14; light.Parent = crystal
        end
        block("Перемычка", Vector3.new(15, 1.5, 3), origin * CFrame.new(0, 7.5, 5), stone)
        local altar = block("Рунический алтарь", Vector3.new(4, 2.2, 3), origin * CFrame.new(0, 1.7, 0), stone, Enum.Material.Marble)
        local rune = block("Символ стихии", Vector3.new(1.4, 0.15, 1.4), origin * CFrame.new(0, 2.9, 0) * CFrame.Angles(0, math.pi/4, 0), color, Enum.Material.Neon, false)
        World.prompt(altar, "Пробудить печать", seal.Name, function(player, position) callbacks.seal(player, position, index) end)
        -- Three silhouettes: ruined chapel, shallow moon pool, broken observatory.
        if index == 1 then
            for side = -1, 1, 2 do
                block("Стена часовни", Vector3.new(1, 5, 12), origin * CFrame.new(side*8, 2.5, 0), Color3.fromRGB(119, 96, 83), Enum.Material.Brick)
            end
            block("Стела часовни", Vector3.new(3, 10, 2), origin * CFrame.new(0, 5, 8), stone)
        elseif index == 2 then
            local water = block("Лунный бассейн", Vector3.new(11, 0.12, 6), origin * CFrame.new(0, 0.68, 5), color, Enum.Material.Glass, false)
            water.Transparency = 0.4
            for i = 1, 8 do
                local angle = i * math.pi/4
                block("Камни источника", Vector3.new(2, 0.8, 2), origin * CFrame.new(math.cos(angle)*6, 0.9, 5 + math.sin(angle)*3), stone)
            end
        else
            for i = 1, 12 do
                local angle = i * math.pi/6
                block("Звёздный круг", Vector3.new(0.2, 0.15, 2.4), origin * CFrame.new(math.cos(angle)*5, 0.68, math.sin(angle)*5) * CFrame.Angles(0, -angle, 0), color, Enum.Material.Neon, false)
            end
            block("Обелиск", Vector3.new(2, 12, 2), origin * CFrame.new(0, 6, 9) * CFrame.Angles(0, 0, -0.12), stone)
        end
        for z = 14, math.abs(seal.Z) - 12, 6 do
            block("Ответвление тропы", Vector3.new(5, 0.15, 4.5), CFrame.new(seal.X, 0.18, z * math.sign(seal.Z)), Color3.fromRGB(115, 113, 94), Enum.Material.Cobblestone)
        end
    end
    for index, point in {Vector3.new(107, 1.5, -74), Vector3.new(172, 1.5, 76)} do
        local chest = block("Тайник исследователя", Vector3.new(3.5, 2.5, 2.5), CFrame.new(point), Color3.fromRGB(109, 74, 43), Enum.Material.Wood)
        block("Обруч сундука", Vector3.new(3.65, 0.3, 2.6), CFrame.new(point + Vector3.new(0, 0.7, 0)), Color3.fromRGB(201, 163, 85), Enum.Material.Metal, false)
        World.prompt(chest, "Открыть тайник", "Забытые припасы", function(player, position) callbacks.cache(player, position, index) end)
    end
    local rest = block("Чаша святилища", Vector3.new(3, 2, 3), CFrame.new(7, 1.3, -7), Color3.fromRGB(109, 219, 231), Enum.Material.Neon)
    World.prompt(rest, "Восстановить силы", "Источник первой зари", callbacks.rest)
    local board = block("Карта долины", Vector3.new(5, 4, 0.6), CFrame.new(29, 3, 8) * CFrame.Angles(0, -0.4, 0), Color3.fromRGB(108, 77, 51), Enum.Material.Wood)
    World.label(board, "Три печати → Хранитель → Иар\nM — карта долины", Vector3.new(0, 4, 0))
    -- Bounds align with the existing static Ground. Walls stop falls beyond the first region.
    for _, spec in {
        {Vector3.new(360, 18, 2), Vector3.new(80, 8, -119)},
        {Vector3.new(360, 18, 2), Vector3.new(80, 8, 119)},
        {Vector3.new(2, 18, 240), Vector3.new(-99, 8, 0)},
        {Vector3.new(2, 18, 240), Vector3.new(259, 8, 0)},
    } do
        local wall = block("Граница долины", spec[1], CFrame.new(spec[2]), stone)
        wall.Transparency = 1
    end
end
return Location
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="11">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")
local Shared = ReplicatedStorage:WaitForChild("Eldoria")
local Config = require(Shared.Config)
local Rules = require(Shared.Rules)
local Characters = require(Shared.Characters)
local Chapter = require(Shared.Chapter)
local Profiles = require(script.Parent.Profiles)
local World = require(script.Parent.World)
local Enemies = require(script.Parent.Enemies)
local remotes = Instance.new("Folder"); remotes.Name = "Remotes"; remotes.Parent = Shared
local action = Instance.new("RemoteEvent"); action.Name = "Action"; action.Parent = remotes
local state = Instance.new("RemoteEvent"); state.Name = "State"; state.Parent = remotes
local notice = Instance.new("RemoteEvent"); notice.Name = "Notice"; notice.Parent = remotes
local visual = Instance.new("RemoteEvent"); visual.Name = "Visual"; visual.Parent = remotes
local sessions = {}
local closing = false
local function character(player)
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if root and hum then return root, hum end
    return nil, nil
end
local function message(player, text) if player.Parent then notice:FireClient(player, text) end end
local function publish(player)
    local s = sessions[player]
    if not s or not Profiles.isActive(player) then return end
    local _, hum = character(player)
    state:FireClient(player, {profile = table.clone(s.profile), mana = s.mana, stamina = s.stamina,
        health = if hum then hum.Health else 0, maxHealth = if hum then hum.MaxHealth else 100,
        temporary = Profiles.isTemporary()})
end
local function permitted(player, position)
    local s = sessions[player]; local root, hum = character(player)
    if closing or not s or not Profiles.isActive(player) or not root or hum.Health <= 0 then return false end
    if position and (root.Position - position).Magnitude > 14 then return false end
    return true
end
local function interact(player, position, kind, index)
    if not permitted(player, position) then return end
    local s = sessions[player]; local now = os.clock()
    if now - s.interact < 0.6 then return end
    s.interact = now
    local previousSeals = Chapter.ensure(s.profile).seals
    local result
    if kind == "quest" then
        result = if s.profile.quest == "complete" then Chapter.turnIn(s.profile) else Rules.quest(s.profile)
    elseif kind == "seal" then result = Chapter.seal(s.profile, index)
    elseif kind == "cache" then result = Chapter.cache(s.profile, index)
    elseif kind == "rest" then
        local _, hum = character(player); hum.Health = hum.MaxHealth; s.mana = 100; s.stamina = 100
        result = "Святилище восстановило здоровье, ману и выносливость."
    else result = Rules.trade(s.profile, kind) end
    local _, hum = character(player)
    hum.MaxHealth = 100 + (Rules.level(s.profile.xp) - 1) * 5
    message(player, result)
    if kind == "seal" and Chapter.ensure(s.profile).seals ~= previousSeals then visual:FireClient(player, "ritual", {position = position, color = Config.Spells[s.profile.rune].Color}) end
    publish(player)
end
local world = World.build({
    seal = function(p, pos, index) interact(p, pos, "seal", index) end,
    cache = function(p, pos, index) interact(p, pos, "cache", index) end,
    rest = function(p, pos) interact(p, pos, "rest") end,
    quest = function(p, pos) interact(p, pos, "quest") end,
    sell = function(p, pos) interact(p, pos, "sell") end,
    upgrade = function(p, pos) interact(p, pos, "upgrade") end,
})
local enemies = Enemies.new(world, {
    canEngage = function(player, e)
        local s = sessions[player]
        return s ~= nil and (e.kind ~= "warden" or Chapter.canFightBoss(s.profile))
    end,
    death = function(position) visual:FireAllClients("death", {position = position}) end,
    character = function(player)
        if not permitted(player) then return nil, nil end
        return character(player)
    end,
    damage = function(player, amount)
        if not permitted(player) then return end
        local s = sessions[player]; local root, hum = character(player)
        if Vector3.new(root.Position.X, 0, root.Position.Z).Magnitude <= Config.SafeRadius or os.clock() < s.invulnerable then return end
        if s.blocking and s.stamina >= 10 then s.stamina -= 10; amount *= 0.3 end
        hum:TakeDamage(amount); publish(player)
        visual:FireAllClients("hit", {position = root.Position, damage = amount, color = Color3.fromRGB(255, 110, 105)})
    end,
    reward = function(player, reward, kind)
        if not permitted(player) then return end
        local s = sessions[player]; local before = Rules.level(s.profile.xp)
        Rules.reward(s.profile, reward.XP, reward.Gold, reward.Shards)
        if kind == "warden" and Chapter.defeat(s.profile) then message(player, "Хранитель повержен! Вернитесь к Иару.") end
        local _, hum = character(player)
        hum.MaxHealth = 100 + (Rules.level(s.profile.xp) - 1) * 5
        if Rules.level(s.profile.xp) > before then hum.Health = hum.MaxHealth; message(player, "Новый уровень!") end
        message(player, "+" .. reward.XP .. " опыта · +" .. reward.Gold .. " золота · осколки +" .. reward.Shards)
        publish(player)
    end,
})
local function effect(origin, destination, color)
    local delta = destination - origin
    local p = World.part(world, "Магический след", Vector3.new(0.3, 0.3, math.max(0.1, delta.Magnitude)), (origin + destination) / 2, color, Enum.Material.Neon)
    p.CFrame = CFrame.lookAt((origin + destination) / 2, destination)
    p.CanCollide = false; p.CanQuery = false; p.CanTouch = false
    Debris:AddItem(p, 0.18)
end
local function finiteVector(v)
    return typeof(v) == "Vector3" and v.X == v.X and v.Y == v.Y and v.Z == v.Z
        and math.abs(v.X) < 100000 and math.abs(v.Y) < 100000 and math.abs(v.Z) < 100000
end
-- One bounded input channel. Clients send intent, never damage, rewards or a profile.
action.OnServerEvent:Connect(function(player, kind, payload)
    if not permitted(player) or type(kind) ~= "string" then return end
    local s = sessions[player]; local now = os.clock()
    s.tokens = math.min(12, s.tokens + (now - s.tokenTime) * 8); s.tokenTime = now
    if s.tokens < 1 then return end
    s.tokens -= 1
    local root, hum = character(player)
    if kind == "sync" then publish(player); return end
    if kind == "rune" then
        if type(payload) == "string" and Config.Spells[payload] then s.profile.rune = payload; publish(player) end
        return
    end
    if kind == "block" then
        if type(payload) == "boolean" then s.blocking = payload; hum.WalkSpeed = if payload then 9 else 16 end
        return
    end
    if s.blocking then return end
    if kind == "dodge" then
        if now < s.dodge or s.stamina < Config.Dodge.Cost then return end
        s.dodge = now + Config.Dodge.Cooldown; s.stamina -= Config.Dodge.Cost
        s.invulnerable = now + Config.Dodge.Duration
        local delta = root.CFrame.LookVector * 10
        local params = RaycastParams.new(); params.FilterDescendantsInstances = {player.Character}
        local hit = workspace:Raycast(root.Position, delta, params)
        if hit then delta = delta.Unit * math.max(0, hit.Distance - 3) end
        visual:FireAllClients("dodge", {position = root.Position})
        player.Character:PivotTo(player.Character:GetPivot() + delta)
        publish(player); return
    end
    if kind ~= "attack" and kind ~= "cast" then return end
    if Vector3.new(root.Position.X, 0, root.Position.Z).Magnitude <= Config.SafeRadius then return end
    local aim = root.CFrame.LookVector
    if payload ~= nil then
        if not finiteVector(payload) then return end
        local direction = payload - root.Position
        if direction.Magnitude < 0.01 then return end
        aim = direction.Unit
    end
    local spell = Config.Spells[s.profile.rune]
    local range, damage, color
    if kind == "attack" then
        if now < s.attack or s.stamina < Config.Attack.Stamina then return end
        s.attack = now + Config.Attack.Cooldown; s.stamina -= Config.Attack.Stamina
        s.combo = if now - s.lastAttack <= 1.2 then s.combo % 3 + 1 else 1
        s.lastAttack = now
        range = Config.Attack.Range
        damage = Config.Attack.Damage + s.profile.blade * 6 + Rules.level(s.profile.xp) * 2
        if s.combo == 3 then damage *= 1.4 end
        color = Color3.fromRGB(240, 218, 155)
    else
        if now < s.cast or s.mana < spell.Cost then return end
        s.cast = now + spell.Cooldown; s.mana -= spell.Cost
        range = spell.Range; damage = spell.Damage + Rules.level(s.profile.xp) * 2; color = spell.Color
    end
    visual:FireAllClients("swing", {user = player.UserId, cast = kind == "cast"})
    local target = enemies:target(player, range, aim)
    if target and target.kind == "warden" and not Chapter.canFightBoss(s.profile) then
        message(player, "Хранителя защищают три печати. Сначала пробудите их.")
        target = nil
    end
    if target then
        local destination = target.body.Position
        enemies:hit(target, player, damage, kind == "cast" and s.profile.rune == "frost")
        visual:FireAllClients("hit", {position = destination, damage = damage, color = color, delay = if kind == "cast" then math.clamp((destination-root.Position).Magnitude/140,0.05,0.35) else 0})
        if kind == "cast" then visual:FireAllClients("cast", {origin = root.Position, destination = destination, color = color, rune = s.profile.rune}) end
        effect(root.Position, destination, color)
        if kind == "cast" and s.profile.rune == "storm" then
            for _, other in enemies.list do
                if other ~= target and other.hp > 0 and (other.kind ~= "warden" or Chapter.canFightBoss(s.profile)) and (other.body.Position - destination).Magnitude <= 12 then
                    enemies:hit(other, player, damage * 0.5, false)
                end
            end
        end
    else
        local destination = root.Position + aim * math.min(range, 18)
        if kind == "cast" then visual:FireAllClients("cast", {origin = root.Position, destination = destination, color = color, rune = s.profile.rune}) end
        effect(root.Position, destination, color)
    end
    publish(player)
end)
local function setupCharacter(player, char)
    local hum = char:WaitForChild("Humanoid", 10)
    local root = char:WaitForChild("HumanoidRootPart", 10)
    local s = sessions[player]
    if not hum or not root or not s then return end
    s.mana = 100; s.stamina = 100; s.blocking = false; s.invulnerable = os.clock() + 3
    hum.MaxHealth = 100 + (Rules.level(s.profile.xp) - 1) * 5; hum.Health = hum.MaxHealth
    hum.WalkSpeed = 16
    Characters.equip(char)
    publish(player)
end
local function join(player)
    local profile = Profiles.load(player)
    if not profile then player:Kick("Не удалось безопасно загрузить данные. Повторите вход позже."); return end
    if closing or not player.Parent then Profiles.save(player, true); return end
    Chapter.ensure(profile)
    sessions[player] = {profile = profile, mana = 100, stamina = 100, tokens = 12, tokenTime = os.clock(),
        attack = 0, cast = 0, dodge = 0, invulnerable = 0, interact = 0, combo = 0, lastAttack = 0, blocking = false}
    player.CharacterAdded:Connect(function(char) setupCharacter(player, char) end)
    if player.Character then task.spawn(setupCharacter, player, player.Character) end
    message(player, "Добро пожаловать в Эльдорию. Поговорите с Иаром у святилища.")
end
Players.PlayerAdded:Connect(join)
for _, player in Players:GetPlayers() do task.spawn(join, player) end
Players.PlayerRemoving:Connect(function(player)
    Profiles.save(player, true); sessions[player] = nil
end)
local elapsed, broadcast = 0, 0
RunService.Heartbeat:Connect(function(dt)
    elapsed += dt; broadcast += dt
    if elapsed < 0.2 or closing then return end
    local step = math.min(elapsed, 0.5); elapsed = 0
    for player, s in sessions do
        s.mana = math.min(100, s.mana + step * 7)
        s.stamina = math.min(100, s.stamina + step * (if s.blocking then 0 else 16))
        local root, hum = character(player)
        if root and hum.Health > 0 and root.Position.Y < -25 then hum.Health = 0 end
        if broadcast >= 1 then publish(player) end
    end
    enemies:step(step)
    if broadcast >= 1 then broadcast = 0 end
end)
task.spawn(function()
    while not closing do
        task.wait(Config.Persistence.Autosave)
        if closing then break end
        for player in sessions do task.spawn(Profiles.save, player, false) end
    end
end)
game:BindToClose(function()
    closing = true
    local pending = 0
    for player in sessions do
        pending += 1
        task.spawn(function() Profiles.save(player, true); pending -= 1 end)
    end
    local deadline = os.clock() + 25
    while pending > 0 and os.clock() < deadline do task.wait(0.1) end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Profiles</string>
          <string name="Source"><![CDATA[-- A failed load NEVER becomes a writable default profile.
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Eldoria")
local Rules = require(Shared.Rules)
local Settings = require(Shared.Config).Persistence
local store = nil -- Acquire only inside the protected persistent-mode request.
local Profiles = {}
local sessions = {}
local token = game.JobId .. ":" .. HttpService:GenerateGUID(false)
-- Studio defaults to explicitly temporary profiles. Set the ModuleScript attribute
-- EnableStudioSaving=true only in a separately published test universe.
local temporary = RunService:IsStudio() and script:GetAttribute("EnableStudioSaving") ~= true
local function update(key, transform)
    local lastError
    for attempt = 1, Settings.Attempts do
        local ok, result = pcall(function()
            if not store then store = DataStoreService:GetDataStore(Settings.Store) end
            return store:UpdateAsync(key, transform)
        end)
        if ok then return true, result end
        lastError = result
        task.wait(attempt)
    end
    warn("ELDORIA DataStore request failed:", lastError)
    return false, nil
end
function Profiles.load(player)
    local key = "player_" .. player.UserId
    if temporary then
        sessions[player] = {data = Rules.new(), busy = false, closing = false}
        return sessions[player].data, true
    end
    local ok, record = update(key, function(old)
        if old ~= nil then
            if type(old) ~= "table" or not Rules.validate(old.data) then return nil end
            if old.owner ~= nil and old.owner ~= token and type(old.lease) == "number" and old.lease > os.time() then return nil end
        end
        return {data = if old then old.data else Rules.new(), owner = token, lease = os.time() + Settings.Lease}
    end)
    if not ok or not record or record.owner ~= token or not Rules.validate(record.data) then return nil, false end
    sessions[player] = {data = record.data, busy = false, closing = false, lastSave = os.clock()}
    return record.data, false
end
function Profiles.save(player, release)
    local session = sessions[player]
    if not session then return true end
    if release then session.closing = true end
    -- A leave waits for the in-flight autosave, then releases the latest profile.
    while session.busy do task.wait(0.05) end
    if sessions[player] ~= session then return true end
    session.busy = true
    if temporary then
        session.busy = false
        if release then sessions[player] = nil end
        return true
    end
    local snapshot = table.clone(session.data)
    local ok, record = update("player_" .. player.UserId, function(old)
        if type(old) ~= "table" or old.owner ~= token then return nil end
        return {data = snapshot, owner = if release then nil else token, lease = if release then 0 else os.time() + Settings.Lease}
    end)
    session.busy = false
    if ok and record and record.data and (release or record.owner == token) then
        session.lastSave = os.clock()
        if release then sessions[player] = nil end
        return true
    end
    -- Never continue playing past an uncertain lock lease.
    session.closing = true
    if player.Parent then player:Kick("Сохранение недоступно. Перезайдите через несколько минут.") end
    return false
end
function Profiles.isActive(player)
    local s = sessions[player]
    return s ~= nil and not s.closing
end
function Profiles.isTemporary() return temporary end
return Profiles
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Scenery</string>
          <string name="Source"><![CDATA[-- Original modular scenery, created without Toolbox scripts or asset downloads.
local Lighting = game:GetService("Lighting")
local Chapter = require(game:GetService("ReplicatedStorage").Eldoria.Chapter)
local Scenery = {}
function Scenery.build(root, World)
    local decor = Instance.new("Folder"); decor.Name = "Окружение"; decor.Parent = root
    local stone = Color3.fromRGB(94, 103, 106)
    local wood = Color3.fromRGB(91, 66, 46)
    local gold = Color3.fromRGB(219, 166, 74)
    local function part(name, size, cf, color, material, collide)
        local p = World.part(decor, name, size, cf.Position, color, material)
        p.CFrame = cf
        if collide == false then p.CanCollide = false; p.CanQuery = false; p.CanTouch = false end
        return p
    end
    local function house(x, z, yaw, color)
        local origin = CFrame.new(x, 0, z) * CFrame.Angles(0, math.rad(yaw), 0)
        local function p(n, s, v, c, m, rotation)
            return part(n, s, origin * CFrame.new(v) * (rotation or CFrame.identity), c, m)
        end
        p("Каменное основание", Vector3.new(16, 1, 14), Vector3.new(0, 0.5, 0), stone)
        p("Штукатурка", Vector3.new(15, 7, 0.6), Vector3.new(0, 4.5, 6), color)
        for _, side in {-1, 1} do
            p("Боковая стена", Vector3.new(0.6, 7, 12), Vector3.new(side * 7.5, 4.5, 0), color)
            p("Вход", Vector3.new(5.4, 7, 0.6), Vector3.new(side * 4.8, 4.5, -6), color)
            p("Стойка", Vector3.new(0.6, 8, 0.8), Vector3.new(side * 7.5, 4.5, -6.2), wood, Enum.Material.Wood)
            p("Скат крыши", Vector3.new(9.5, 0.7, 15), Vector3.new(side * 4, 9, 0), Color3.fromRGB(70, 85, 98), Enum.Material.Slate, CFrame.Angles(0, 0, math.rad(-side * 28)))
            p("Окно", Vector3.new(1.8, 2.4, 0.3), Vector3.new(side * 4.5, 4.7, -6.4), gold, Enum.Material.Neon)
            p("Переплёт", Vector3.new(0.15, 2.6, 0.4), Vector3.new(side * 4.5, 4.7, -6.6), wood)
        end
        p("Балка", Vector3.new(16, 0.6, 0.8), Vector3.new(0, 7.8, -6.1), wood, Enum.Material.Wood)
        p("Над дверью", Vector3.new(4, 2, 0.6), Vector3.new(0, 7, -6), color)
        p("Труба", Vector3.new(2, 5, 2), Vector3.new(4, 10, 2), stone, Enum.Material.Brick)
        p("Ступень", Vector3.new(4, 0.4, 2), Vector3.new(0, 0.2, -8), stone)
    end
    house(-32, -28, -25, Color3.fromRGB(178, 163, 130))
    house(22, 34, 180, Color3.fromRGB(160, 149, 129))
    house(-38, 25, 135, Color3.fromRGB(146, 154, 147))
    -- Paved circle and segmented paths leave the main combat corridor unobstructed.
    for i = 1, 20 do
        local angle = i * math.pi / 10
        part("Камни святилища", Vector3.new(3, 0.25, 4), CFrame.new(math.cos(angle) * 20, 0.2, math.sin(angle) * 20) * CFrame.Angles(0, -angle, 0), stone)
    end
    for x = 26, 204, 6 do
        for _, z in {-3, 3} do
            part("Плита тропы", Vector3.new(4.5, 0.2, 3.5), CFrame.new(x, 0.24, z), Color3.fromRGB(106, 107, 94), Enum.Material.Cobblestone)
        end
    end
    for _, x in {30, 54, 78, 122, 158, 188} do
        local lantern = part("Фонарь", Vector3.new(0.8, 1.2, 0.8), CFrame.new(x, 6, -10), gold, Enum.Material.Neon, false)
        part("Столб фонаря", Vector3.new(0.3, 6, 0.3), CFrame.new(x, 3, -10), wood, Enum.Material.Wood)
        local light = Instance.new("PointLight"); light.Color = gold; light.Range = 14; light.Brightness = 0.7; light.Shadows = false; light.Parent = lantern
    end
    local rng = Random.new(173)
    for i = 1, 56 do
        local x, z = rng:NextNumber(52, 246), rng:NextNumber(-96, 96)
        if math.abs(z) < 25 or (x > 193 and math.abs(z) < 35) then continue end
        local reserved = false
        for _, seal in Chapter.Seals do
            if (Vector3.new(x, 0, z) - Vector3.new(seal.X, 0, seal.Z)).Magnitude < 17 then reserved = true end
        end
        for _, cache in {Vector3.new(107,0,-74), Vector3.new(172,0,76)} do
            if (Vector3.new(x,0,z)-cache).Magnitude < 10 then reserved = true end
        end
        if reserved then continue end
        local height = rng:NextNumber(10, 19)
        local trunk = part("Кора", Vector3.new(2.3, height, 2.3), CFrame.new(x, height/2, z), wood, Enum.Material.Wood)
        trunk.Shape = Enum.PartType.Cylinder; trunk.Size = Vector3.new(height, 2.3, 2.3); trunk.CFrame *= CFrame.Angles(0, 0, math.pi/2)
        for tier = 1, 3 do
            local width = 15 - tier * 2
            local crown = part("Листва", Vector3.new(width, 8, width), CFrame.new(x, height - 2 + tier * 3, z), Color3.fromRGB(32 + tier*5, 64 + i%4*6, 54 + tier*3), Enum.Material.Grass, false)
            crown.Shape = Enum.PartType.Ball
        end
        if i % 3 == 0 then
            local rock = part("Валун", Vector3.new(5, 3, 4), CFrame.new(x + 4, 1.5, z + 4) * CFrame.Angles(0.2, i, 0.3), stone, Enum.Material.Rock)
            rock.Shape = Enum.PartType.Ball
        end
        if i % 2 == 0 then
            for j = 1, 3 do
                part("Лунный цветок", Vector3.new(0.3, 0.7, 0.3), CFrame.new(x + j, 0.7, z - j), Color3.fromRGB(112, 192, 207), Enum.Material.Neon, false)
            end
        end
    end
    -- Ruined colonnade around the boss, with a broad, unobstructed centre.
    for _, z in {-25, 25} do
        for x = 185, 235, 25 do
            part("Основание колонны", Vector3.new(6, 1, 6), CFrame.new(x, 0.5, z), stone)
            part("Колонна", Vector3.new(3, 13, 3), CFrame.new(x, 7, z), stone, Enum.Material.Marble)
            part("Капитель", Vector3.new(5, 1, 5), CFrame.new(x, 14, z), stone)
        end
        part("Разрушенная арка", Vector3.new(31, 2, 4), CFrame.new(197, 15, z), stone)
    end
    for i = 1, 9 do
        local angle = i * math.pi * 2/9
        local pos = Vector3.new(220 + math.cos(angle)*15, 0.3, math.sin(angle)*15)
        part("Руна разлома", Vector3.new(0.4, 0.1, 3), CFrame.new(pos) * CFrame.Angles(0, -angle, 0), Color3.fromRGB(169, 89, 231), Enum.Material.Neon, false)
    end
    local fire = part("Угли костра", Vector3.new(2, 0.4, 2), CFrame.new(7, 0.3, 14), Color3.fromRGB(210, 105, 40), Enum.Material.Neon, false)
    local flame = Instance.new("Fire"); flame.Size = 4; flame.Heat = 3; flame.Parent = fire
    for i = 1, 8 do
        local a = i * math.pi/4
        part("Очаг", Vector3.new(1, 0.7, 1), CFrame.new(7 + math.cos(a)*2, 0.35, 14 + math.sin(a)*2), stone)
    end
    -- Distant silhouettes also hide the rectangular edges of the small first region.
    for i = 1, 24 do
        local x = -65 + i * 13
        for _, z in {-112, 112} do
            local peak = part("Скалы на горизонте", Vector3.new(24, rng:NextNumber(20, 42), 22), CFrame.new(x, 5, z) * CFrame.Angles(0.15, i*0.7, 0.25), Color3.fromRGB(66, 79, 85), Enum.Material.Rock)
            peak.Shape = Enum.PartType.Ball
        end
    end
    local function lighting(class, name)
        local instance = Lighting:FindFirstChild(name) or Instance.new(class)
        instance.Name = name; instance.Parent = Lighting; return instance
    end
    Lighting.ClockTime = 17.3; Lighting.Brightness = 2
    Lighting.Ambient = Color3.fromRGB(94, 103, 120); Lighting.OutdoorAmbient = Color3.fromRGB(114, 128, 142)
    local atmosphere = lighting("Atmosphere", "EldoriaAtmosphere")
    atmosphere.Density = 0.28; atmosphere.Offset = 0.1
    atmosphere.Color = Color3.fromRGB(180, 198, 211); atmosphere.Decay = Color3.fromRGB(104, 91, 129)
    local bloom = lighting("BloomEffect", "EldoriaBloom"); bloom.Intensity = 0.25; bloom.Size = 24; bloom.Threshold = 1.2
    local grade = lighting("ColorCorrectionEffect", "EldoriaGrade")
    grade.Saturation = -0.08; grade.Contrast = 0.1; grade.TintColor = Color3.fromRGB(235, 239, 255)
end
return Scenery
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">World</string>
          <string name="Source"><![CDATA[local Characters = require(game:GetService("ReplicatedStorage"):WaitForChild("Eldoria").Characters)
local Scenery = require(script.Parent.Scenery)
local FirstLocation = require(script.Parent.FirstLocation)
local World = {}
function World.part(parent, name, size, position, color, material)
    local p = Instance.new("Part")
    p.Name = name; p.Size = size; p.Position = position; p.Anchored = true
    p.Color = color; p.Material = material or Enum.Material.Slate; p.Parent = parent
    return p
end
function World.label(part, text, offset)
    local gui = Instance.new("BillboardGui")
    gui.Size = UDim2.fromOffset(190, 58); gui.StudsOffset = offset or Vector3.new(0, 5, 0)
    gui.AlwaysOnTop = false; gui.MaxDistance = 90; gui.Parent = part
    local label = Instance.new("TextLabel")
    label.Size = UDim2.fromScale(1, 1); label.BackgroundTransparency = 1
    label.TextColor3 = Color3.fromRGB(245, 227, 180); label.TextStrokeTransparency = 0.4
    label.Font = Enum.Font.GothamBold; label.TextSize = 16; label.TextWrapped = true
    label.Text = text; label.Parent = gui
    return label
end
function World.prompt(part, action, title, callback)
    local p = Instance.new("ProximityPrompt")
    p.KeyboardKeyCode = Enum.KeyCode.T
    p.ActionText = action; p.ObjectText = title; p.MaxActivationDistance = 12
    p.HoldDuration = 0.3; p.RequiresLineOfSight = true; p.Parent = part
    p.Triggered:Connect(function(player) callback(player, part.Position) end)
end
function World.build(callbacks)
    assert(not workspace:FindFirstChild("EldoriaWorld"), "World already exists")
    local root = Instance.new("Folder"); root.Name = "EldoriaWorld"; root.Parent = workspace
    local ground = workspace:FindFirstChild("Ground") or World.part(root, "Земля", Vector3.new(360, 4, 240), Vector3.new(80, -2, 0), Color3.fromRGB(53, 73, 53), Enum.Material.Grass)
    ground.Parent = root
    World.part(root, "Тропа", Vector3.new(180, 0.15, 12), Vector3.new(80, 0.1, 0), Color3.fromRGB(116, 100, 76), Enum.Material.Ground)
    local spawn = workspace:FindFirstChild("SanctuarySpawn") or Instance.new("SpawnLocation")
    spawn.Name = "Святилище"; spawn.Anchored = true; spawn.Size = Vector3.new(12, 1, 12)
    spawn.Position = Vector3.new(0, 0.7, 0); spawn.Neutral = true; spawn.Duration = 3
    spawn.Color = Color3.fromRGB(118, 163, 164); spawn.Material = Enum.Material.Marble; spawn.Parent = root
    World.label(spawn, "ЭЛЬДОРИЯ\nДолина первой зари · святилище", Vector3.new(0, 8, 0))
    local _, elder = Characters.create(root, "Хранитель Иар", Vector3.new(14, 2.8, -12), "elder")
    World.label(elder, "Иар · хранитель\nЗадание: трещина в завесе")
    World.prompt(elder, "Поговорить", "Хранитель Иар", callbacks.quest)
    local forge = World.part(root, "Кузница", Vector3.new(5, 3, 4), Vector3.new(-12, 1.5, -12), Color3.fromRGB(87, 94, 108), Enum.Material.Metal)
    World.label(forge, "Кузница\n3 осколка + золото")
    World.prompt(forge, "Улучшить клинок", "Кузница", callbacks.upgrade)
    local _, trader = Characters.create(root, "Торговец", Vector3.new(-12, 2.8, 13), "merchant")
    World.label(trader, "Лавка\nОсколок → 8 золота")
    World.prompt(trader, "Продать осколок", "Торговец", callbacks.sell)
    local sign = World.part(root, "Указатель", Vector3.new(1, 5, 5), Vector3.new(46, 2.5, -10), Color3.fromRGB(108, 84, 59), Enum.Material.Wood)
    World.label(sign, "→ Сумрачная роща\nОпасность за границей святилища")
    Scenery.build(root, World)
    FirstLocation.build(root, World, callbacks)
    local gate = World.part(root, "Разлом", Vector3.new(5, 18, 13), Vector3.new(220, 9, 0), Color3.fromRGB(143, 89, 255), Enum.Material.Neon)
    gate.CanCollide = false
    World.label(gate, "РАЗЛОМ\nХранитель пробуждается", Vector3.new(0, 13, 0))
    local light = Instance.new("PointLight"); light.Color = gate.Color; light.Range = 30; light.Brightness = 2; light.Parent = gate
    return root
end
return World
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="15">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="16">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="17">
        <Properties>
          <string name="Name">Eldoria</string>
        </Properties>
        <Item class="LocalScript" referent="18">
          <Properties>
            <string name="Name">Location</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Eldoria")
local Chapter = require(Shared:WaitForChild("Chapter"))
local player = Players.LocalPlayer
local gui = Instance.new("ScreenGui"); gui.Name = "EldoriaLocation"; gui.ResetOnSpawn = false; gui.Parent = player:WaitForChild("PlayerGui")
local map = Instance.new("Frame"); map.Size = UDim2.fromOffset(500, 390); map.AnchorPoint = Vector2.new(0.5, 0.5)
map.Position = UDim2.fromScale(0.5, 0.5); map.BackgroundColor3 = Color3.fromRGB(23, 34, 39)
map.BorderSizePixel = 0; map.Visible = false; map.Parent = gui
local scale = Instance.new("UIScale"); scale.Parent = map
local function resize()
    local camera = workspace.CurrentCamera
    if camera then scale.Scale = math.min(1, (camera.ViewportSize.X-24)/500, (camera.ViewportSize.Y-70)/390) end
end
resize()
if workspace.CurrentCamera then workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(resize) end
local function label(parent, text, x, y, w, h, size)
    local l = Instance.new("TextLabel"); l.BackgroundTransparency = 1; l.TextColor3 = Color3.fromRGB(231, 219, 179)
    l.Font = Enum.Font.Gotham; l.TextSize = size or 14; l.TextWrapped = true; l.Text = text
    l.Position = UDim2.fromOffset(x,y); l.Size = UDim2.fromOffset(w,h); l.Parent = parent; return l
end
label(map, "ДОЛИНА ПЕРВОЙ ЗАРИ", 20, 10, 460, 30, 21)
label(map, "Карта · M — закрыть · точки обозначают реальные места", 20, 42, 460, 25, 12)
local field = Instance.new("Frame"); field.Position = UDim2.fromOffset(20, 80); field.Size = UDim2.fromOffset(460, 220)
field.BackgroundColor3 = Color3.fromRGB(42, 61, 54); field.BorderSizePixel = 0; field.Parent = map
local function point(x,z) return UDim2.fromScale((x+100)/360,(z+120)/240) end
local road = Instance.new("Frame"); road.BorderSizePixel = 0; road.BackgroundColor3 = Color3.fromRGB(115, 103, 76)
road.Position = point(0,-3); road.Size = UDim2.fromScale(220/360,6/240); road.Parent = field
local function marker(x,z,name,color)
    local dot = Instance.new("TextLabel"); dot.Size = UDim2.fromOffset(14,14); dot.AnchorPoint = Vector2.new(0.5,0.5)
    dot.Position = point(x,z); dot.BackgroundColor3 = color; dot.BorderSizePixel = 0; dot.Text = ""; dot.Parent = field
    local title = label(dot,name,-38,14,90,30,11)
    return dot, title
end
marker(0,0,"Святилище",Color3.fromRGB(220,190,110))
marker(220,0,"Хранитель",Color3.fromRGB(190,95,115))
local seals = {}
for i, seal in Chapter.Seals do
    local dot, title = marker(seal.X,seal.Z,({"Часовня", "Источник", "Обсерватория"})[i],Color3.fromRGB(130,150,180))
    seals[i] = {dot = dot, title = title}
end
local you = marker(0,0,"Вы",Color3.fromRGB(230,240,255)); you.ZIndex = 3
local objective = label(map,"",20,310,460,65,14)
local open = Instance.new("TextButton"); open.Size = UDim2.fromOffset(140,30); open.Position = UDim2.new(1,-155,0,190)
open.BackgroundColor3 = Color3.fromRGB(25,32,45); open.TextColor3 = Color3.fromRGB(220,203,151)
open.TextSize = 13; open.Font = Enum.Font.Gotham; open.Text = "Карта долины · M"; open.Parent = gui
local close = Instance.new("TextButton"); close.Size = UDim2.fromOffset(30,30); close.Position = UDim2.new(1,-35,0,5)
close.Text = "×"; close.TextSize = 22; close.Parent = map
local function toggle() map.Visible = not map.Visible end
open.Activated:Connect(toggle); close.Activated:Connect(function() map.Visible = false end)
UIS.InputBegan:Connect(function(input,processed)
    if not processed and not UIS:GetFocusedTextBox() and input.KeyCode == Enum.KeyCode.M then toggle() end
end)
Shared:WaitForChild("Remotes"):WaitForChild("State").OnClientEvent:Connect(function(snapshot)
    local p = snapshot.profile; local c = Chapter.ensure(p)
    objective.Text = Chapter.objective(p)
    local world = workspace:FindFirstChild("EldoriaWorld")
    local gate = world and world:FindFirstChild("Разлом")
    if gate then
        gate.Transparency = if c.boss then 1 else 0.15
        local light = gate:FindFirstChildOfClass("PointLight")
        if light then light.Enabled = not c.boss end
        local billboard = gate:FindFirstChildOfClass("BillboardGui")
        local caption = billboard and billboard:FindFirstChildOfClass("TextLabel")
        if caption and c.boss then caption.Text = "РАЗЛОМ ЗАКРЫТ\nВернитесь к Иару" end
    end
    for i, view in seals do
        view.dot.BackgroundColor3 = if Chapter.has(c.seals,i) then Color3.fromRGB(117,223,157) else Color3.fromRGB(130,150,180)
    end
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if root then you.Position = point(root.Position.X,root.Position.Z) end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="19">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Eldoria")
local Rules = require(Shared:WaitForChild("Rules"))
local Chapter = require(Shared:WaitForChild("Chapter"))
local Config = require(Shared:WaitForChild("Config"))
local remotes = Shared:WaitForChild("Remotes")
local action = remotes:WaitForChild("Action")
local state = remotes:WaitForChild("State")
local notice = remotes:WaitForChild("Notice")
local player = Players.LocalPlayer
local gui = Instance.new("ScreenGui"); gui.Name = "EldoriaHUD"; gui.ResetOnSpawn = false
-- Respect device safe areas and the Roblox top bar.
gui.IgnoreGuiInset = false; gui.Parent = player:WaitForChild("PlayerGui")
local canvas = Instance.new("Frame"); canvas.Name = "Canvas"; canvas.BackgroundTransparency = 1
canvas.Size = UDim2.fromOffset(960, 600); canvas.AnchorPoint = Vector2.new(0.5, 0.5)
canvas.Position = UDim2.fromScale(0.5, 0.5); canvas.Parent = gui
local scale = Instance.new("UIScale"); scale.Parent = canvas
local function resize()
    local camera = workspace.CurrentCamera
    if camera then scale.Scale = math.min(camera.ViewportSize.X / 980, math.max(200, camera.ViewportSize.Y - 60) / 600) end
end
resize()
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(resize)
if workspace.CurrentCamera then workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(resize) end
local gold = Color3.fromRGB(225, 193, 127)
local function panel(name, x, y, w, h)
    local f = Instance.new("Frame"); f.Name = name; f.Position = UDim2.fromOffset(x, y); f.Size = UDim2.fromOffset(w, h)
    f.BackgroundColor3 = Color3.fromRGB(17, 24, 32); f.BackgroundTransparency = 0.12
    f.BorderSizePixel = 0; f.Parent = canvas
    local corner = Instance.new("UICorner"); corner.CornerRadius = UDim.new(0, 10); corner.Parent = f
    local stroke = Instance.new("UIStroke"); stroke.Color = Color3.fromRGB(77, 88, 94); stroke.Transparency = 0.3; stroke.Parent = f
    return f
end
local function text(parent, value, x, y, w, h, size, color)
    local t = Instance.new("TextLabel"); t.BackgroundTransparency = 1; t.Position = UDim2.fromOffset(x, y); t.Size = UDim2.fromOffset(w, h)
    t.Font = Enum.Font.Gotham; t.TextSize = size or 16; t.TextColor3 = color or Color3.fromRGB(228, 232, 231)
    t.TextXAlignment = Enum.TextXAlignment.Left; t.TextWrapped = true; t.Text = value; t.Parent = parent
    return t
end
local function button(parent, label, x, y, w, h, callback)
    local b = Instance.new("TextButton"); b.Position = UDim2.fromOffset(x, y); b.Size = UDim2.fromOffset(w, h)
    b.BackgroundColor3 = Color3.fromRGB(43, 54, 67); b.TextColor3 = gold; b.Font = Enum.Font.GothamBold
    b.TextSize = 15; b.TextWrapped = true; b.Text = label; b.Parent = parent
    local corner = Instance.new("UICorner"); corner.Parent = b
    b.Activated:Connect(callback); return b
end
local stats = panel("Resources", 20, 20, 290, 160)
text(stats, "ELDORIA · " .. Config.Version, 16, 8, 260, 28, 22, gold)
local level = text(stats, "Загрузка профиля…", 16, 37, 260, 24, 14)
local function bar(y, color)
    local bg = Instance.new("Frame"); bg.Position = UDim2.fromOffset(16, y); bg.Size = UDim2.fromOffset(258, 23)
    bg.BackgroundColor3 = Color3.fromRGB(30, 35, 45); bg.BorderSizePixel = 0; bg.Parent = stats
    local fill = Instance.new("Frame"); fill.Size = UDim2.fromScale(1, 1); fill.BackgroundColor3 = color; fill.BorderSizePixel = 0; fill.Parent = bg
    local label = text(bg, "", 8, 0, 240, 23, 13)
    return function(name, value, maximum)
        fill.Size = UDim2.fromScale(math.clamp(value / maximum, 0, 1), 1)
        label.Text = name .. "  " .. math.ceil(value) .. " / " .. maximum
    end
end
local health = bar(66, Color3.fromRGB(139, 60, 67))
local mana = bar(95, Color3.fromRGB(54, 99, 155))
local stamina = bar(124, Color3.fromRGB(74, 122, 92))
local quest = panel("Quest", 640, 20, 300, 122)
text(quest, "ДОЛИНА ПЕРВОЙ ЗАРИ", 16, 10, 270, 24, 16, gold)
local questText = text(quest, "Найдите хранителя Иара\nв святилище.", 16, 38, 270, 65, 15)
local toast = panel("Notification", 225, 190, 510, 60); toast.Visible = false
local toastText = text(toast, "", 16, 8, 478, 44, 17)
local toastVersion = 0
local function notify(message)
    toastVersion += 1; local id = toastVersion
    toastText.Text = message; toast.Visible = true
    task.delay(4, function() if id == toastVersion then toast.Visible = false end end)
end
notice.OnClientEvent:Connect(notify)
local bag = panel("Inventory", 285, 255, 390, 190); bag.Visible = false
text(bag, "СНАРЯЖЕНИЕ И РЕСУРСЫ", 16, 12, 355, 25, 18, gold)
local bagText = text(bag, "", 16, 43, 355, 132, 16)
local hotbar = panel("Actions", 235, 510, 705, 70)
local rune = "fire"; local blocking = false; local menuOpen = true
local function aim()
    if UIS.TouchEnabled then return nil end
    return player:GetMouse().Hit.Position
end
local function send(kind, payload)
    if menuOpen then return end
    action:FireServer(kind, payload)
end
button(hotbar, "Клинок\nЛКМ", 8, 8, 100, 54, function() send("attack", aim()) end)
local spellButton = button(hotbar, "Огонь\nE", 116, 8, 110, 54, function() send("cast", aim()) end)
button(hotbar, "Уклонение\nR", 234, 8, 110, 54, function() send("dodge") end)
local blockButton
blockButton = button(hotbar, "Блок\nF", 352, 8, 100, 54, function()
    if menuOpen then return end
    blocking = not blocking; send("block", blocking)
    blockButton.Text = if blocking then "Блок: ВКЛ\nF" else "Блок\nF"
end)
button(hotbar, "Руна\nQ", 460, 8, 100, 54, function()
    local nextRune = ({fire = "frost", frost = "storm", storm = "fire"})[rune]
    send("rune", nextRune)
end)
button(hotbar, "Рюкзак\nI", 568, 8, 125, 54, function() bag.Visible = not bag.Visible end)
local menu = panel("Welcome", 220, 175, 520, 300)
text(menu, "E L D O R I A", 30, 25, 460, 45, 34, gold)
text(menu, "Три печати забыли свои имена.\nВерните им огонь, лёд и бурю — и бросьте вызов Хранителю.", 30, 82, 460, 65, 18)
text(menu, "WASD — движение · E — магия · R — уклонение\nF — блок · Q — руна · I — рюкзак · T — взаимодействие\nНа телефоне используйте кнопки снизу.", 30, 150, 460, 70, 15)
button(menu, "ВОЙТИ В ЭЛЬДОРИЮ", 80, 235, 360, 45, function()
    menu.Visible = false; menuOpen = false; action:FireServer("sync")
end)
UIS.InputBegan:Connect(function(input, processed)
    if processed or menuOpen or UIS:GetFocusedTextBox() then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 then send("attack", aim()); return end
    local key = input.KeyCode
    if key == Enum.KeyCode.E then send("cast", aim())
    elseif key == Enum.KeyCode.R then send("dodge")
    elseif key == Enum.KeyCode.F then
        blocking = not blocking; send("block", blocking)
        blockButton.Text = if blocking then "Блок: ВКЛ\nF" else "Блок\nF"
    elseif key == Enum.KeyCode.Q then send("rune", ({fire = "frost", frost = "storm", storm = "fire"})[rune])
    elseif key == Enum.KeyCode.I then bag.Visible = not bag.Visible end
end)
player.CharacterAdded:Connect(function() blocking = false; blockButton.Text = "Блок\nF" end)
state.OnClientEvent:Connect(function(snapshot)
    local p = snapshot.profile; rune = p.rune
    local currentLevel = Rules.level(p.xp)
    level.Text = "Уровень " .. currentLevel .. " · опыт " .. p.xp .. (if currentLevel < 200 then " / " .. Rules.threshold(currentLevel + 1) else " · MAX")
    health("Здоровье", snapshot.health, snapshot.maxHealth); mana("Мана", snapshot.mana, 100); stamina("Выносливость", snapshot.stamina, 100)
    spellButton.Text = Config.Spells[rune].Name .. "\nE · " .. Config.Spells[rune].Cost .. " маны"
    questText.Text = Chapter.objective(p)
    bagText.Text = "Клинок святилища +" .. p.blade .. " (макс. +5)\nЗолото: " .. p.gold .. "\nОсколки: " .. p.shards .. " / 999\nУлучшение: 3 осколка + " .. (30 * (p.blade + 1)) .. " золота\n" .. (if snapshot.temporary then "STUDIO: прогресс временный, не сохраняется." else "Прогресс сохраняется автоматически.")
end)
-- Connect listeners first; don't rely on the initial server message arriving after UI creation.
action:FireServer("sync")
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="20">
          <Properties>
            <string name="Name">Presentation</string>
            <string name="Source"><![CDATA[-- Local presentation only; this script cannot grant damage, loot or invulnerability.
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Eldoria")
local rigs = {}
local fx = Instance.new("Folder"); fx.Name = "EldoriaLocalEffects"; fx.Parent = workspace
local function register(model)
    local root = model:WaitForChild("Root", 10)
    if not root then return end
    local pieces = {}
    for _, p in model:GetChildren() do
        if p:IsA("BasePart") and p:GetAttribute("LocalPose") then table.insert(pieces, p) end
    end
    if not model.Parent then return end
    rigs[model] = {root = root, pieces = pieces, previous = root.Position, phase = 0, speed = 0}
end
for _, model in CollectionService:GetTagged("EldoriaRig") do task.spawn(register, model) end
CollectionService:GetInstanceAddedSignal("EldoriaRig"):Connect(function(model) task.spawn(register, model) end)
CollectionService:GetInstanceRemovedSignal("EldoriaRig"):Connect(function(model) rigs[model] = nil end)
local frame = 0
RunService.RenderStepped:Connect(function(dt)
    frame += dt
    if frame < 1/30 then return end
    local step = frame; frame = 0
    local camera = workspace.CurrentCamera
    for model, rig in rigs do
        if not model.Parent then rigs[model] = nil; continue end
        local root = rig.root
        local delta = root.Position - rig.previous; rig.previous = root.Position
        rig.speed += (math.min(16, delta.Magnitude / step) - rig.speed) * math.min(1, step * 8)
        rig.phase += step * (2 + rig.speed * 0.7)
        if camera and (camera.CFrame.Position - root.Position).Magnitude > 180 then continue end
        local walk = math.sin(rig.phase) * math.min(0.65, rig.speed * 0.075)
        local age = workspace:GetServerTimeNow() - (root:GetAttribute("AttackStart") or -100)
        local swing = if age >= 0 and age < 1 then math.sin(math.min(1, age / 0.8) * math.pi) else 0
        local idle = math.sin(rig.phase) * 0.04
        for _, p in rig.pieces do
            local group = p:GetAttribute("Limb")
            local rotation = CFrame.identity
            if group == "leftArm" then rotation = CFrame.Angles(-walk + swing * 0.8, 0, -0.08)
            elseif group == "rightArm" then rotation = CFrame.Angles(walk - swing * 2.2, swing * 0.3, 0.08)
            elseif group == "leftLeg" then rotation = CFrame.Angles(walk, 0, 0)
            elseif group == "rightLeg" then rotation = CFrame.Angles(-walk, 0, 0)
            elseif group == "head" then rotation = CFrame.Angles(idle, idle * 2, 0) end
            local pivot = p:GetAttribute("Pivot")
            p.CFrame = root.CFrame * CFrame.new(0, idle, 0) * CFrame.new(pivot) * rotation * CFrame.new(-pivot) * p:GetAttribute("LocalPose")
        end
    end
end)
local function ball(position, color, startSize, endSize, duration)
    local p = Instance.new("Part"); p.Shape = Enum.PartType.Ball; p.Size = Vector3.one * startSize
    p.Position = position; p.Anchored = true; p.CanCollide = false; p.CanQuery = false; p.CanTouch = false
    p.Material = Enum.Material.Neon; p.Color = color; p.Transparency = 0.25; p.Parent = fx
    TweenService:Create(p, TweenInfo.new(duration), {Size = Vector3.one * endSize, Transparency = 1}):Play()
    Debris:AddItem(p, duration)
end
local function hitNumber(position, damage, color)
    local anchor = Instance.new("Part"); anchor.Anchored = true; anchor.Transparency = 1
    anchor.Size = Vector3.one * 0.1; anchor.Position = position + Vector3.new(0, 3, 0)
    anchor.CanCollide = false; anchor.CanQuery = false; anchor.CanTouch = false; anchor.Parent = fx
    local gui = Instance.new("BillboardGui"); gui.Size = UDim2.fromOffset(100, 50); gui.AlwaysOnTop = true; gui.Parent = anchor
    local text = Instance.new("TextLabel"); text.Size = UDim2.fromScale(1, 1); text.BackgroundTransparency = 1
    text.Font = Enum.Font.GothamBold; text.TextSize = 27; text.TextColor3 = color
    text.TextStrokeTransparency = 0.5; text.Text = tostring(math.floor(damage)); text.Parent = gui
    TweenService:Create(anchor, TweenInfo.new(0.8), {Position = anchor.Position + Vector3.new(0, 3, 0)}):Play()
    TweenService:Create(text, TweenInfo.new(0.8), {TextTransparency = 1}):Play(); Debris:AddItem(anchor, 0.85)
end
local function line(a, b, color, width, lifetime)
    if (b-a).Magnitude < 0.01 then return end
    local p = Instance.new("Part"); p.Size = Vector3.new(width, width, (b-a).Magnitude)
    p.CFrame = CFrame.lookAt((a+b)/2,b); p.Anchored = true; p.CanCollide = false
    p.CanQuery = false; p.CanTouch = false; p.Material = Enum.Material.Neon; p.Color = color; p.Parent = fx
    TweenService:Create(p,TweenInfo.new(lifetime),{Transparency = 1}):Play(); Debris:AddItem(p,lifetime)
end
local function glyph(position, color, radius, lifetime)
    for i = 1, 12 do
        local a, b = i*math.pi/6, (i+1)*math.pi/6
        line(position+Vector3.new(math.cos(a)*radius,0,math.sin(a)*radius),position+Vector3.new(math.cos(b)*radius,0,math.sin(b)*radius),color,0.1,lifetime)
    end
    for i = 1, 3 do
        local a = i*math.pi*2/3
        line(position+Vector3.new(math.cos(a)*radius,0,math.sin(a)*radius),position+Vector3.new(math.cos(a+math.pi*2/3)*radius,0,math.sin(a+math.pi*2/3)*radius),color,0.09,lifetime)
    end
end
local swings = {}
local function swing(character, cast)
    if not character then return end
    local weapon = character:FindFirstChild("EldoriaBlade")
    local handle = weapon and weapon:FindFirstChild("Handle")
    local grip = handle and handle:FindFirstChild("BladeGrip")
    if not grip then return end
    local entry = swings[grip]
    if entry then entry.tween:Cancel() end
    local base = if entry then entry.base else grip.C0
    local tween = TweenService:Create(grip, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, true),
        {C0 = base * CFrame.Angles(math.rad(if cast then -40 else -110), 0, math.rad(if cast then 0 else -45))})
    local state = {base = base, tween = tween}; swings[grip] = state
    local trail = handle:FindFirstChildOfClass("Trail"); if trail then trail.Enabled = true end
    tween:Play()
    task.delay(0.45, function()
        if swings[grip] ~= state then return end
        swings[grip] = nil
        if grip.Parent then grip.C0 = base end
        if trail and trail.Parent then trail.Enabled = false end
    end)
end
local visual = Shared:WaitForChild("Remotes"):WaitForChild("Visual")
visual.OnClientEvent:Connect(function(kind, data)
    if kind == "swing" then
        local player = Players:GetPlayerByUserId(data.user)
        swing(player and player.Character, data.cast)
    elseif kind == "hit" then
        task.delay(data.delay or 0, function()
            ball(data.position, data.color, 0.5, 4, 0.25); hitNumber(data.position, data.damage, data.color)
        end)
    elseif kind == "death" then
        ball(data.position, Color3.fromRGB(183, 110, 255), 2, 9, 0.7)
        for i = 1, 8 do
            local angle = i * math.pi / 4
            ball(data.position + Vector3.new(math.cos(angle) * 2, 0.5, math.sin(angle) * 2), Color3.fromRGB(160, 220, 250), 0.6, 0.05, 0.6)
        end
    elseif kind == "dodge" then ball(data.position, Color3.fromRGB(130, 220, 230), 2, 6, 0.35)
    elseif kind == "ritual" then
        glyph(data.position + Vector3.new(0, 1.3, 0), data.color, 6, 1.8)
        ball(data.position, data.color, 1, 12, 1.2)
    elseif kind == "cast" then
        local origin, destination = data.origin, data.destination
        glyph(origin + Vector3.new(0,-2.6,0), data.color, 2.4, 0.4)
        if data.rune == "storm" then
            local previous = origin
            for i = 1, 7 do
                local point = origin:Lerp(destination,i/7)
                if i < 7 then point += Vector3.new(math.sin(i*4)*1.3,math.cos(i*3)*1.2,0) end
                line(previous, point, data.color, 0.2, 0.22); previous = point
            end
        end
        local p = Instance.new("Part"); p.Shape = Enum.PartType.Ball; p.Size = Vector3.one * 1.2
        p.Anchored = true; p.CanCollide = false; p.CanTouch = false; p.CanQuery = false
        p.Material = Enum.Material.Neon; p.Color = data.color; p.Position = origin; p.Parent = fx
        if data.rune == "frost" then
            p.Shape = Enum.PartType.Block; p.Size = Vector3.new(0.4,0.4,2.4)
            if (destination-origin).Magnitude > 0.01 then p.CFrame = CFrame.lookAt(origin,destination) end
        end
        local a = Instance.new("Attachment"); a.Position = Vector3.new(0,0.4,0); a.Parent = p
        local b = Instance.new("Attachment"); b.Position = Vector3.new(0,-0.4,0); b.Parent = p
        local trail = Instance.new("Trail"); trail.Attachment0 = a; trail.Attachment1 = b
        trail.Lifetime = 0.15; trail.Color = ColorSequence.new(data.color); trail.Parent = p
        local duration = math.clamp((destination - origin).Magnitude / 140, 0.05, 0.35)
        TweenService:Create(p, TweenInfo.new(duration, Enum.EasingStyle.Linear), {Position = destination, Size = Vector3.one * 0.2, Transparency = 1}):Play()
        Debris:AddItem(p, duration + 0.2)
        task.delay(duration, function()
            if data.rune == "fire" then
                ball(destination,data.color,1,7,0.45)
            elseif data.rune == "frost" then
                glyph(Vector3.new(destination.X,0.3,destination.Z),data.color,4,0.65)
                for i = 1, 6 do
                    local a = i*math.pi/3
                    local foot = destination + Vector3.new(math.cos(a)*2,-2,math.sin(a)*2)
                    line(foot,foot+Vector3.new(math.cos(a),3,math.sin(a)),data.color,0.35,0.65)
                end
            else glyph(Vector3.new(destination.X,0.3,destination.Z),data.color,4,0.4) end
        end)
    end
end)

-- Small, functional quality switch; remains usable if the main HUD fails to initialise.
local gui = Instance.new("ScreenGui"); gui.Name = "EldoriaGraphics"; gui.ResetOnSpawn = false
local button = Instance.new("TextButton"); button.Size = UDim2.fromOffset(140, 30)
button.Position = UDim2.new(1, -155, 0, 155); button.BackgroundColor3 = Color3.fromRGB(25, 32, 45)
button.TextColor3 = Color3.fromRGB(220, 203, 151); button.TextSize = 13; button.Font = Enum.Font.Gotham
button.Text = "Свечение: вкл"; button.Parent = gui; gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
local enabled = true
button.Activated:Connect(function()
    enabled = not enabled; button.Text = if enabled then "Свечение: вкл" else "Свечение: выкл"
    local bloom = game:GetService("Lighting"):FindFirstChild("EldoriaBloom")
    if bloom then bloom.Enabled = enabled end
end)
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="21">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="NeedsPivotMigration">false</bool>
    </Properties>
    <Item class="Part" referent="22">
      <Properties>
        <string name="Name">Ground</string>
        <bool name="Anchored">true</bool>
        <bool name="CanCollide">true</bool>
        <Color3uint8 name="Color3uint8">3492149</Color3uint8>
        <Vector3 name="Position">
          <X>80</X>
          <Y>-2</Y>
          <Z>0</Z>
        </Vector3>
        <Vector3 name="size">
          <X>360</X>
          <Y>4</Y>
          <Z>240</Z>
        </Vector3>
      </Properties>
    </Item>
    <Item class="SpawnLocation" referent="23">
      <Properties>
        <string name="Name">SanctuarySpawn</string>
        <bool name="Anchored">true</bool>
        <bool name="CanCollide">true</bool>
        <bool name="Neutral">true</bool>
        <Vector3 name="Position">
          <X>0</X>
          <Y>0.7</Y>
          <Z>0</Z>
        </Vector3>
        <Vector3 name="size">
          <X>12</X>
          <Y>1</Y>
          <Z>12</Z>
        </Vector3>
      </Properties>
    </Item>
  </Item>
</roblox>