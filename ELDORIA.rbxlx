      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">Chapter</string>
          <string name="Source"><![CDATA[--!strict
-- First location progression. All mutations are invoked by the server only.
local Chapter = {}
export type Progress = {seals: number, caches: number, boss: boolean, finished: boolean}
Chapter.Seals = {
    {Name = "Угольная часовня", Rune = "fire", X = 84, Z = -40},
    {Name = "Лунный источник", Rune = "frost", X = 137, Z = 42},
    {Name = "Обсерватория бури", Rune = "storm", X = 181, Z = -42},
}
function Chapter.ensure(p: any): Progress
    if p.chapter == nil then p.chapter = {seals = 0, caches = 0, boss = false, finished = false} end
    return p.chapter
end
function Chapter.has(mask: number, index: number): boolean
    return math.floor(mask / 2 ^ (index - 1)) % 2 == 1
end
function Chapter.count(mask: number): number
    local total = 0
    for i = 1, 3 do if Chapter.has(mask, i) then total += 1 end end
    return total
end
local function reward(p: any, xp: number, gold: number)
    p.xp = math.min(1000000000, p.xp + xp); p.gold = math.min(1000000000, p.gold + gold)
end
function Chapter.seal(p: any, index: number): string
    local c = Chapter.ensure(p); local definition = Chapter.Seals[index]
    if not definition then return "Неизвестная печать." end
    if p.quest ~= "complete" then return "Сначала выполните поручение Иара и вернитесь к нему." end
    if Chapter.has(c.seals, index) then return "Эта печать уже пробуждена." end
    if p.rune ~= definition.Rune then return "Нужна руна: " .. definition.Rune .. ". Смените руну кнопкой Q." end
    c.seals += 2 ^ (index - 1); reward(p, 40, 20)
    return "Печать пробуждена: " .. Chapter.count(c.seals) .. " / 3. +40 опыта, +20 золота."
end
function Chapter.cache(p: any, index: number): string
    if index ~= 1 and index ~= 2 then return "Неизвестный тайник." end
    local c = Chapter.ensure(p)
    if Chapter.has(c.caches, index) then return "Тайник уже найден этим персонажем." end
    c.caches += 2 ^ (index - 1); reward(p, 25, 25); p.shards = math.min(999, p.shards + 2)
    return "Тайник исследователя: +25 опыта, +25 золота, +2 осколка."
end
function Chapter.canFightBoss(p: any): boolean
    local c = Chapter.ensure(p)
    return p.quest == "complete" and c.seals == 7
end
function Chapter.defeat(p: any): boolean
    if not Chapter.canFightBoss(p) then return false end
    Chapter.ensure(p).boss = true; return true
end
function Chapter.turnIn(p: any): string
    local c = Chapter.ensure(p)
    if c.finished then return "Долина спасена. Исследуйте тайники и совершенствуйте клинок." end
    if not c.boss then return "Пробудите три печати и победите Хранителя у разлома." end
    c.finished = true; reward(p, 250, 150)
    return "ГЛАВА ЗАВЕРШЕНА: Долина первой зари. +250 опыта, +150 золота."
end
function Chapter.objective(p: any): string
    local c = Chapter.ensure(p)
    if p.quest == "available" then return "Поговорите с Иаром в святилище." end
    if p.quest == "active" then return "Победите стражей: " .. p.kills .. " / 3.\nЗатем вернитесь к Иару." end
    if c.finished then return "Долина первой зари спасена!\nТайники: " .. Chapter.count(c.caches) .. " / 2. Клинок можно улучшать дальше." end
    if c.boss then return "Вернитесь к Иару за наградой главы." end
    if c.seals ~= 7 then return "Пробудите печати: " .. Chapter.count(c.seals) .. " / 3.\nЧасовня — огонь; источник — лёд; обсерватория — буря." end
    return "Победите Хранителя у разлома.\nУклоняйтесь из красных кругов!"
end
return Chapter
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">Characters</string>
          <string name="Source"><![CDATA[-- Original, self-contained articulated low-poly characters; no external assets.
local CollectionService = game:GetService("CollectionService")
local Characters = {}
local bone = Color3.fromRGB(191, 182, 148)
local iron = Color3.fromRGB(54, 64, 83)
local violet = Color3.fromRGB(177, 90, 255)
local function piece(model, name, size, cf, color, material, group, pivot)
    local part = Instance.new("Part")
    part.Name = name; part.Size = size; part.CFrame = cf; part.Color = color
    part.Material = material or Enum.Material.SmoothPlastic
    part.Anchored = true; part.CanCollide = false; part.CanTouch = false; part.CanQuery = false
    part:SetAttribute("LocalPose", cf); part:SetAttribute("Limb", group or "body")
    part:SetAttribute("Pivot", pivot or Vector3.zero); part.Parent = model
    return part
end
function Characters.create(parent, name, position, kind)
    local model = Instance.new("Model"); model.Name = name
    local boss = kind == "warden"
    local caster = kind == "shade"
    local human = kind == "elder" or kind == "merchant"
    local scale = if boss then 1.65 else 1
    local glow = if human or caster then Color3.fromRGB(120, 225, 225) else violet
    local armor = if human then Color3.fromRGB(75, 90, 125) else iron
    local root = Instance.new("Part"); root.Name = "Root"; root.Anchored = true
    root.Size = Vector3.new(3, 5, 2) * scale; root.Transparency = 1
    root.CanCollide = false; root.CanTouch = false; root.CFrame = CFrame.new(position)
    root.Parent = model; model.PrimaryPart = root
    local function add(n, size, pos, color, group, pivot, material)
        return piece(model, n, size * scale, CFrame.new(pos * scale), color, material, group, pivot and pivot * scale)
    end
    local skin = if human then Color3.fromRGB(199, 159, 118) else bone
    add("Spine", Vector3.new(0.5, 2, 0.6), Vector3.new(0, 0.3, 0), skin)
    for i = 1, 3 do
        add("Rib", Vector3.new(2.1 - i * 0.18, 0.23, 0.9), Vector3.new(0, 1.2 - i * 0.45, 0), skin)
    end
    add("Armor", Vector3.new(2.25, 0.9, 1.1), Vector3.new(0, 0.8, 0.05), armor)
    add("Core", Vector3.new(0.4, 0.5, 0.25), Vector3.new(0, 0.85, -0.63), glow, nil, nil, Enum.Material.Neon)
    add("Belt", Vector3.new(1.8, 0.45, 1), Vector3.new(0, -0.8, 0), armor)
    add("Skull", Vector3.new(1.35, 1.25, 1.15), Vector3.new(0, 2.1, 0), skin, "head", Vector3.new(0, 1.45, 0))
    add("Jaw", Vector3.new(0.95, 0.28, 0.9), Vector3.new(0, 1.4, -0.05), skin, "head", Vector3.new(0, 1.45, 0))
    for _, side in {-1, 1} do
        add("EyeSocket", Vector3.new(0.47, 0.4, 0.12), Vector3.new(side * 0.34, 2.2, -0.59), iron, "head", Vector3.new(0, 1.45, 0))
        add("Eye", Vector3.new(0.24, 0.18, 0.13), Vector3.new(side * 0.34, 2.2, -0.67), glow, "head", Vector3.new(0, 1.45, 0), Enum.Material.Neon)
        local arm = if side == -1 then "leftArm" else "rightArm"
        local leg = if side == -1 then "leftLeg" else "rightLeg"
        local ap = Vector3.new(side * 1.4, 1, 0)
        local lp = Vector3.new(side * 0.6, -0.9, 0)
        add("Pauldron", Vector3.new(0.95, 0.7, 1.2), Vector3.new(side * 1.4, 1, 0), armor, arm, ap)
        add("Arm", Vector3.new(0.45, 1.9, 0.5), Vector3.new(side * 1.4, -0.1, 0), skin, arm, ap)
        add("Gauntlet", Vector3.new(0.7, 0.65, 0.8), Vector3.new(side * 1.4, -0.95, 0), armor, arm, ap)
        add("Leg", Vector3.new(0.5, 1.65, 0.55), Vector3.new(side * 0.6, -1.7, 0), skin, leg, lp)
        add("Boot", Vector3.new(0.8, 0.6, 1.1), Vector3.new(side * 0.6, -2.45, -0.2), armor, leg, lp)
    end
    if human or caster then
        add("Robe", Vector3.new(2, 2.5, 1.3), Vector3.new(0, -0.2, 0.1), if kind == "elder" then Color3.fromRGB(83, 63, 122) else Color3.fromRGB(107, 79, 46))
        add("Hood", Vector3.new(1.6, 0.4, 1.4), Vector3.new(0, 2.85, 0), armor, "head", Vector3.new(0, 1.45, 0))
    end
    if not human then
        local ap = Vector3.new(1.4, 1, 0)
        add("SwordGrip", Vector3.new(0.25, 0.8, 0.25), Vector3.new(1.4, -1, -0.7), iron, "rightArm", ap)
        add("SwordGuard", Vector3.new(1, 0.18, 0.3), Vector3.new(1.4, -0.6, -0.7), armor, "rightArm", ap)
        add("SwordBlade", Vector3.new(0.35, 2.5, 0.16), Vector3.new(1.4, 0.7, -0.7), glow, "rightArm", ap, Enum.Material.Neon)
    end
    if boss then
        for i = -2, 2 do
            add("CrownSpike", Vector3.new(0.2, 0.75 + math.abs(i) * 0.2, 0.3), Vector3.new(i * 0.3, 3, 0), glow, "head", Vector3.new(0, 1.45, 0), Enum.Material.Neon)
        end
    end
    for _, part in model:GetChildren() do
        if part:IsA("BasePart") and part ~= root then part.CFrame = root.CFrame * part:GetAttribute("LocalPose") end
    end
    model:SetAttribute("Style", kind); model.Parent = parent
    CollectionService:AddTag(model, "EldoriaRig")
    return model, root
end
function Characters.equip(character)
    local hand = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
    if not hand or character:FindFirstChild("EldoriaBlade") then return end
    local model = Instance.new("Model"); model.Name = "EldoriaBlade"
    local handle = Instance.new("Part"); handle.Name = "Handle"; handle.Size = Vector3.new(0.25, 1, 0.25)
    handle.CFrame = hand.CFrame; handle.Color = iron; handle.CanCollide = false
    handle.CanTouch = false; handle.CanQuery = false; handle.Massless = true; handle.Parent = model
    local grip = Instance.new("Motor6D"); grip.Name = "BladeGrip"; grip.Part0 = hand; grip.Part1 = handle
    grip.C0 = CFrame.new(0, -0.6, -0.4) * CFrame.Angles(math.rad(-90), 0, 0); grip.Parent = handle
    for _, spec in {
        {"Guard", Vector3.new(1.2, 0.18, 0.35), CFrame.new(0, 0.55, 0), Color3.fromRGB(203, 167, 85)},
        {"Blade", Vector3.new(0.42, 2.8, 0.16), CFrame.new(0, 2, 0), Color3.fromRGB(184, 209, 224)},
        {"RuneEdge", Vector3.new(0.1, 2.5, 0.19), CFrame.new(0, 2, 0), Color3.fromRGB(100, 230, 244)},
    } do
        local p = Instance.new("Part"); p.Name = spec[1]; p.Size = spec[2]; p.CFrame = handle.CFrame * spec[3]
        p.Color = spec[4]; p.Material = if spec[1] == "RuneEdge" then Enum.Material.Neon else Enum.Material.Metal
        p.CanCollide = false; p.CanTouch = false; p.CanQuery = false; p.Massless = true; p.Parent = model
        local weld = Instance.new("WeldConstraint"); weld.Part0 = handle; weld.Part1 = p; weld.Parent = p
    end
    local a = Instance.new("Attachment"); a.Position = Vector3.new(0, 0.8, 0); a.Parent = handle
    local b = Instance.new("Attachment"); b.Position = Vector3.new(0, 3.4, 0); b.Parent = handle
    local trail = Instance.new("Trail"); trail.Attachment0 = a; trail.Attachment1 = b
    trail.Lifetime = 0.18; trail.Color = ColorSequence.new(Color3.fromRGB(120, 225, 255))
    trail.Transparency = NumberSequence.new(0.2, 1); trail.Enabled = false; trail.Parent = handle
    model.Parent = character
end
return Characters
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--!strict
return table.freeze({
    Version = "0.3.0",
    SafeRadius = 48,
    Attack = {Damage = 18, Range = 10, Cooldown = 0.5, Stamina = 10},
    Dodge = {Cost = 24, Cooldown = 1.6, Duration = 0.35},
    Spells = {
        fire = {Name = "Огонь", Damage = 32, Cost = 22, Cooldown = 2, Range = 65, Color = Color3.fromRGB(255, 120, 50)},
        frost = {Name = "Лёд", Damage = 20, Cost = 18, Cooldown = 2.5, Range = 55, Color = Color3.fromRGB(100, 220, 255)},
        storm = {Name = "Буря", Damage = 24, Cost = 28, Cooldown = 3, Range = 45, Color = Color3.fromRGB(200, 150, 255)},
    },
    Enemies = {
        shade = {Name = "Пепельный заклинатель", Health = 65, Damage = 15, Speed = 7, XP = 45, Gold = 16, Shards = 1, Respawn = 22, Aggro = 55},
        sentinel = {Name = "Осколочный страж", Health = 80, Damage = 12, Speed = 10, XP = 35, Gold = 12, Shards = 1, Respawn = 18, Aggro = 45},
        warden = {Name = "Хранитель разлома", Health = 400, Damage = 24, Speed = 8, XP = 200, Gold = 80, Shards = 5, Respawn = 60, Aggro = 55},
    },
    Persistence = {Store = "Eldoria_v1", Lease = 180, Autosave = 50, Attempts = 3},
})
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Rules</string>
          <string name="Source"><![CDATA[--!strict
-- Pure domain rules: runnable in the standalone Luau VM without Roblox services.
local Rules = {}
export type Profile = {
    version: number, xp: number, gold: number, shards: number, blade: number,
    quest: string, kills: number, rune: string,
    chapter: {seals: number, caches: number, boss: boolean, finished: boolean}?,
}
function Rules.integer(value: any, low: number, high: number): boolean
    return type(value) == "number" and value == value and value % 1 == 0 and value >= low and value <= high
end
function Rules.new(): Profile
    return {version = 1, xp = 0, gold = 0, shards = 0, blade = 0, quest = "available", kills = 0, rune = "fire"}
end
function Rules.validate(value: any): boolean
    if type(value) ~= "table" or value.version ~= 1 then return false end
    for _, key in {"xp", "gold"} do
        if not Rules.integer(value[key], 0, 1000000000) then return false end
    end
    if value.chapter ~= nil then
        if type(value.chapter) ~= "table" then return false end
        local c: any = value.chapter
        if not Rules.integer(c.seals, 0, 7) or not Rules.integer(c.caches, 0, 3)
            or type(c.boss) ~= "boolean" or type(c.finished) ~= "boolean" then return false end
        if (c.boss and c.seals ~= 7) or (c.finished and not c.boss) then return false end
    end
    return Rules.integer(value.shards, 0, 999) and Rules.integer(value.blade, 0, 5)
        and Rules.integer(value.kills, 0, 3)
        and (value.quest == "available" or value.quest == "active" or value.quest == "complete")
        and (value.rune == "fire" or value.rune == "frost" or value.rune == "storm")
end
function Rules.level(xp: number): number
    return math.min(200, math.floor(math.sqrt(xp / 50)) + 1)
end
function Rules.threshold(level: number): number
    return 50 * (level - 1) ^ 2
end
function Rules.reward(p: Profile, xp: number, gold: number, shards: number)
    p.xp = math.min(1000000000, p.xp + xp)
    p.gold = math.min(1000000000, p.gold + gold)
    p.shards = math.min(999, p.shards + shards)
    if p.quest == "active" then p.kills = math.min(3, p.kills + 1) end
end
function Rules.quest(p: Profile): string
    if p.quest == "available" then p.quest = "active"; return "Задание принято: победите трёх стражей." end
    if p.quest == "active" and p.kills >= 3 then
        p.quest = "complete"
        p.xp = math.min(1000000000, p.xp + 120)
        p.gold = math.min(1000000000, p.gold + 60)
        return "Тропа очищена! +120 опыта, +60 золота. Теперь пробудите три печати."
    end
    return if p.quest == "complete" then "Спасибо, защитник Эльдории." else "Победите трёх врагов и вернитесь."
end
function Rules.trade(p: Profile, action: string): string
    if action == "sell" then
        if p.shards < 1 then return "Нет осколков для продажи." end
        p.shards -= 1; p.gold = math.min(1000000000, p.gold + 8)
        return "Осколок продан за 8 золота."
    end
    if action == "upgrade" then
        local cost = 30 * (p.blade + 1)
        if p.blade >= 5 then return "Клинок уже максимального уровня." end
        if p.gold < cost or p.shards < 3 then return "Нужно 3 осколка и " .. cost .. " золота." end
        p.gold -= cost; p.shards -= 3; p.blade += 1
        return "Клинок улучшен до +" .. p.blade .. "."
    end
    return "Неизвестная операция."
end
return Rules
]]></string>
        </Properties>
      </Item>
