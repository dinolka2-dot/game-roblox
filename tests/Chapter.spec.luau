local Rules = require("../src/shared/Rules")
local Chapter = require("../src/shared/Chapter")
local total = 0
local function test(name, fn)
    local ok, err = pcall(fn); assert(ok,name .. ": " .. tostring(err)); total += 1; print("PASS " .. name)
end
local function trained()
    local p = Rules.new(); p.quest = "complete"; p.kills = 3; Chapter.ensure(p); return p
end
test("legacy profile gains chapter without losing progress",function()
    local p = trained(); p.chapter = nil; p.gold = 77; p.blade = 2
    assert(Rules.validate(p)); Chapter.ensure(p)
    assert(p.gold == 77 and p.blade == 2 and p.chapter.seals == 0 and Rules.validate(p))
end)
test("seals require completed training",function()
    local p = Rules.new(); Chapter.seal(p,1); assert(p.chapter.seals == 0 and p.gold == 0)
end)
test("wrong rune cannot activate a seal",function()
    local p = trained(); Chapter.seal(p,2); assert(p.chapter.seals == 0 and p.gold == 0)
end)
test("each seal rewards once even under repeated interaction",function()
    local p = trained()
    for i, seal in Chapter.Seals do
        p.rune = seal.Rune
        for _ = 1, 10 do Chapter.seal(p,i) end
    end
    assert(p.chapter.seals == 7 and p.xp == 120 and p.gold == 60 and Rules.validate(p))
end)
test("seal order is free and tracked independently",function()
    local p = trained(); p.rune = "storm"; Chapter.seal(p,3)
    assert(Chapter.has(p.chapter.seals,3) and not Chapter.has(p.chapter.seals,1))
    assert(Chapter.count(p.chapter.seals) == 1)
end)
test("invalid seal indices do not mutate progress",function()
    local p = trained(); Chapter.seal(p,0); Chapter.seal(p,99); assert(p.chapter.seals == 0)
end)
test("boss cannot be completed before all seals",function()
    local p = trained(); assert(not Chapter.canFightBoss(p)); assert(not Chapter.defeat(p)); assert(not p.chapter.boss)
end)
test("chapter reward requires a boss kill and is exactly once",function()
    local p = trained(); Chapter.turnIn(p); assert(not p.chapter.finished and p.gold == 0)
    for i, seal in Chapter.Seals do p.rune = seal.Rune; Chapter.seal(p,i) end
    Chapter.turnIn(p); assert(not p.chapter.finished)
    assert(Chapter.defeat(p)); Chapter.turnIn(p)
    for _ = 1, 10 do Chapter.turnIn(p) end
    assert(p.chapter.finished and p.xp == 370 and p.gold == 210 and Rules.validate(p))
end)
test("two caches are individually idempotent",function()
    local p = trained()
    for _ = 1, 10 do Chapter.cache(p,1); Chapter.cache(p,2) end
    assert(p.chapter.caches == 3 and p.gold == 50 and p.xp == 50 and p.shards == 4)
end)
test("unknown cache cannot grant rewards",function()
    local p = trained(); Chapter.cache(p,3); assert(p.gold == 0)
end)
test("chapter data rejects malformed masks and impossible completion",function()
    local p = trained(); p.chapter.seals = 8; assert(not Rules.validate(p))
    p.chapter.seals = 0; p.chapter.finished = true; assert(not Rules.validate(p))
    p.chapter.finished = false; p.chapter.boss = true; assert(not Rules.validate(p))
end)
test("objectives cover every playable stage",function()
    local p = Rules.new(); assert(string.find(Chapter.objective(p),"Иар"))
    p.quest = "active"; assert(string.find(Chapter.objective(p),"страж"))
    p.quest = "complete"; assert(string.find(Chapter.objective(p),"печати"))
    p.chapter.seals = 7; assert(string.find(Chapter.objective(p),"Хранителя"))
    Chapter.defeat(p); assert(string.find(Chapter.objective(p),"Иару"))
    Chapter.turnIn(p); assert(string.find(Chapter.objective(p),"спасена"))
end)
print(total .. " chapter tests passed")
